pipeline {
    agent any
    environment {
        PATH = "${WORKSPACE}/bin:/usr/local/bin:${env.PATH}"
    }
    stages {
        stage('Checkout (git checkout)') {
            steps {
                checkout scm
            }
        }
        stage('Install Tools') {
            steps {
                echo 'Installing Minikube and Kubectl...'
                sh '''
            set -e

            OS=$(uname -s | tr '[:upper:]' '[:lower:]')   # darwin or linux
            ARCH=$(uname -m)
            case "$ARCH" in
                x86_64) ARCH=amd64 ;;
                arm64|aarch64) ARCH=arm64 ;;
            esac

            echo "Detected OS=$OS ARCH=$ARCH"

            # Download and install kubectl
            KUBECTL_VERSION=$(curl -L -s https://dl.k8s.io/release/stable.txt)
            curl -LO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/${OS}/${ARCH}/kubectl"
            chmod +x ./kubectl

            # Download and install minikube
            curl -LO "https://storage.googleapis.com/minikube/releases/latest/minikube-${OS}-${ARCH}"
            chmod +x "minikube-${OS}-${ARCH}"

            mkdir -p bin
            mv ./kubectl ./bin/kubectl
            mv "./minikube-${OS}-${ARCH}" ./bin/minikube
        '''
            }
        }
        stage('Start Minikube') {
            steps {
                echo 'Starting Minikube using Docker driver...'
                // You must start Minikube so kubectl has a cluster to validate against
                sh 'minikube start --driver=docker'
            }
        }
        stage('Create DB Secret') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'postgres-creds', usernameVariable: 'DB_USER', passwordVariable: 'DB_PASS')]) {
                    sh '''
                        # Delete existing secret if present without failing the build if it does not exist
                        kubectl delete secret secret-postgres --ignore-not-found
                        kubectl create secret generic secret-postgres --from-literal=username=$DB_USER --from-literal=password=$DB_PASS
                        
                        # Force Kubernetes to pick up secret changes on existing pods
                        kubectl rollout restart statefulset/urlshortener-db || true
                        kubectl rollout restart deployment/urlshortener-app || true
                    '''

                }
            }
        }
        stage('Test and validating manifests') {
            steps {
                dir('services/UrL_shortener_Service') {
                    sh 'kubectl apply --dry-run=client -f k8s'
                }
            }
        }
        stage('Building Image After Testing (Containerising it)') {
            steps {
                dir('services/UrL_shortener_Service') {
                    sh ' eval $(minikube docker-env) && docker build -t aaronm10/shortener-service:v1 .'
                }
            }
        }
        stage('Pushing Image to Docker') {
            steps {
                dir('services/UrL_shortener_Service') {
                    sh 'docker push aaronm10/shortener-service:v1'
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                dir('services/UrL_shortener_Service') {
                    sh '''
                        # 1. Apply updated configuration files
                        kubectl apply -f k8s
        
                        # 2. Force a fresh rollout of pods
                        kubectl rollout restart statefulset/urlshortener-db
                        kubectl rollout restart deployment/urlshortener-app
        
                        # 3. Wait for new pods to reach Healthy status
                        kubectl rollout status statefulset/urlshortener-db --timeout=90s
                        kubectl rollout status deployment/urlshortener-app --timeout=90s
                    '''
                    sh 'kubectl get pods'
                }
            }
        }

        stage('Completed') {
            steps {
                echo 'Completed'
                sh 'minikube service urlshortener-app-service --url'
            }
        }
    }
}