pipeline {
    agent any
    stages {
        stage('Checkout (git checkout)') {
            steps {
                checkout scm
            }
        }
        stage('Running minikube') {
            steps {
                sh 'minikube start'
            }
        }
        stage('Test and validating manifests') {
            steps {
                dir('services/UrLshortener-service') {
                    sh 'kubectl apply --dry-run=client -f k8s'
                }
            }
        }
        stage('Building Image After Testing (Containerising it)') {
            steps {
                sh 'docker build -t aaronm10/shortener-service:v1 .'
            }
        }
        stage('Pushing Image to Docker') {
            steps {
                sh 'docker push -t aaronm10/shortener-service:v1 .'
            }
        }

        stage('Completed') {
            steps {
                echo 'Completed'
            }
        }
    }
}